// Tailscale ACL policy for magnanix
// Apply by copying the contents to Tailscale Admin Console: Settings > ACLs
// Or if your Tailscale OAuth client has Policy scope, deploy with:
//   tailscale acl set tailscale-policy/acl.hujson
{
  "acls": [
    // Allow CI runners (tag:ci) to reach muninn's Attic cache
    {
      "action": "accept",
      "src": ["tag:ci"],
      "dst": ["muninn.ts.matos.cc:8080"]
    },

    // Default: allow all traffic between all devices
    // Restrict this as needed for your security posture
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["*:*"]
    }
  ],

  "hosts": {
    // MagicDNS hostnames (Tailscale auto-assigns these)
    // muninn.ts.matos.cc -> muninn's Tailscale IP
  }
}
