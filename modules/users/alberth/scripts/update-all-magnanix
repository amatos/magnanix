#!/usr/bin/env bash
#
# update-all-magnanix: run deploy-magnanix on every host in the fleet, in
# parallel, and report which hosts failed.
#
# Usage: update-all-magnanix [host ...]
#
# With no arguments it deploys every real host (the test VMs in
# modules/hosts/virtual are left out). Remote hosts run it over SSH; the host
# this runs on runs it directly, since sudo on macOS needs Touch ID or a
# password and can't prompt over a non-interactive SSH session.
#
# Hosts too small to evaluate the flake (tenabrae) can't run deploy-magnanix.
# This host builds them from `main` on GitHub instead, and they switch over SSH,
# downloading the build from the Attic cache (documentation/tenabrae.md).
#
# Each host's output is shown prefixed with its name and saved to a log file.
# Exits 0 only if every host deployed; on failure it prints the end of each
# failed host's log and keeps the logs.

set -uo pipefail

# Every real host belongs here: every host in modules/hosts except the test VMs
# (darwintron, nixostron) and CI's ephemeral machines. Add a new host when it's
# added to the flake; update-all-magnanix.bats checks the list against
# modules/hosts.
default_hosts=(fortuna magnus muninn tenabrae)

# Hosts that can't evaluate the flake: built here, then switched over SSH.
build_here_hosts=(tenabrae)
flake=github:amatos/magnanix
# How long such a host waits for the build to reach the Attic cache (the
# builder's `attic watch-store` pushes it): attempts, and seconds between them.
cache_attempts=40
cache_wait=15

if [ $# -gt 0 ]; then
  hosts=("$@")
else
  hosts=("${default_hosts[@]}")
fi

local_host=$(hostname -s | tr '[:upper:]' '[:lower:]')
logdir=$(mktemp -d "${TMPDIR:-/tmp}/update-all-magnanix.XXXXXX")
pids=()

say() { printf 'update-all-magnanix: %s\n' "$*" >&2; }

is_local() { [ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = "$local_host" ]; }

builds_here() {
  local h
  for h in "${build_here_hosts[@]}"; do
    [ "$h" = "$1" ] && return 0
  done
  return 1
}

# BatchMode: fail instead of prompting for a password or host key, which would
# hang a background job. -n: don't read this terminal's stdin.
remote() { ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$@"; }

# Build the host's system from `main` here (or on the remote builders), then
# have the host fetch it from the cache and switch to it. --refresh: don't use
# a copy of `main` fetched earlier. The path is a store path, so it needs no
# quoting.
deploy_built_here() {
  local path
  path=$(nix build --refresh --no-link --print-out-paths \
    "$flake#nixosConfigurations.$1.config.system.build.toplevel") || return 1
  echo "built $path"
  remote "$1" "
    i=1
    until sudo nix-store --realise $path >/dev/null; do
      [ \$i -ge $cache_attempts ] && exit 1
      echo 'waiting for the build to reach the cache'
      sleep $cache_wait
      i=\$((i + 1))
    done
    sudo nix-env --profile /nix/var/nix/profiles/system --set $path \
      && sudo $path/bin/switch-to-configuration switch"
}

deploy() {
  if builds_here "$1"; then
    deploy_built_here "$1"
  elif is_local "$1"; then
    deploy-magnanix
  else
    remote "$1" deploy-magnanix
  fi
}

# Background jobs ignore SIGINT in a script, so Ctrl-C has to be passed on:
# stop each job and everything it started (ssh, deploy-magnanix, nh), then report.
# shellcheck disable=SC2329 # called from on_signal
kill_tree() {
  local child
  # ps rather than pgrep: nixpkgs has no pgrep on macOS.
  for child in $(ps -A -o pid= -o ppid= | awk -v p="$1" '$2 == p { print $1 }'); do
    kill_tree "$child"
  done
  kill -TERM "$1" 2>/dev/null
}

interrupted=0
# shellcheck disable=SC2329 # called from the trap
on_signal() {
  interrupted=1
  say "interrupted; stopping running deployments"
  for pid in "${pids[@]}"; do
    kill_tree "$pid"
  done
}
trap on_signal INT TERM

# The local deploy switches with sudo. Ask for it now, while nothing else is
# writing to the terminal; the background job reuses the cached credential.
for host in "${hosts[@]}"; do
  if is_local "$host" && ! builds_here "$host"; then
    if ! sudo -v; then
      say "sudo failed; can't deploy $host"
      exit 1
    fi
    break
  fi
done

for host in "${hosts[@]}"; do
  (
    deploy "$host" 2>&1 \
      | tee "$logdir/$host.log" \
      | awk -v p="[$host] " '{ print p $0; fflush() }'
    exit "${PIPESTATUS[0]}"
  ) &
  pids+=("$!")
done

say "deploying ${hosts[*]} (logs in $logdir)"

failed=()
for i in "${!hosts[@]}"; do
  host=${hosts[$i]}
  # `wait` returns early when a trapped signal arrives; wait again until the
  # job has really exited.
  while :; do
    wait "${pids[$i]}"
    status=$?
    kill -0 "${pids[$i]}" 2>/dev/null || break
  done
  printf '%s\t%s\n' "$host" "$status" >>"$logdir/status"
  if [ "$status" -ne 0 ]; then
    failed+=("$host")
  fi
done

echo >&2
say "summary"
while IFS=$'\t' read -r host status; do
  case $status in
    0) reason="ok" ;;
    255) reason="failed: ssh error (unreachable, or authentication failed)" ;;
    127) reason="failed: deploy-magnanix not found" ;;
    130 | 143) reason="failed: interrupted" ;;
    *) reason="failed: exit status $status" ;;
  esac
  printf '  %-10s %s\n' "$host" "$reason" >&2
done <"$logdir/status"

if [ ${#failed[@]} -eq 0 ] && [ "$interrupted" -eq 0 ]; then
  rm -rf "$logdir"
  exit 0
fi

for host in "${failed[@]}"; do
  echo >&2
  say "last lines from $host ($logdir/$host.log):"
  tail -n 20 "$logdir/$host.log" | sed 's/^/    /' >&2
done
echo >&2
if [ "$interrupted" -eq 1 ]; then
  say "interrupted; logs kept in $logdir"
  exit 130
fi
say "${#failed[@]} of ${#hosts[@]} hosts failed; logs kept in $logdir"
exit 1
