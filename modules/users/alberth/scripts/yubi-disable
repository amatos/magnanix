#!/bin/sh
#
# Turns off the OpenPGP USB interface of YubiKey 32146072.

if [ -x "$HOME/.nix-profile/bin/ykman" ]; then
    ykman=$HOME/.nix-profile/bin/ykman
elif [ -x /opt/homebrew/bin/ykman ]; then
    ykman=/opt/homebrew/bin/ykman
else
    echo "ykman not found" >&2
    exit 1
fi

if ! "$ykman" -d 32146072 config usb -d openpgp -f; then
    echo "ykman failed to disable OpenPGP" >&2
    exit 1
fi
echo "YubiKey disabled"
