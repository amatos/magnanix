{
  den,
  inputs,
  lib,
  ...
}:
let
  computerName = "Muninn";
  hostName = lib.toLower computerName;
  certbotOwners = "alberth@matos.cc";
in
{
  # Den sets nixpkgs.hostPlatform from this key; it matches the x86_64-linux in
  # _hardware-configuration.nix.
  den.hosts.x86_64-linux.muninn = {
    users.alberth = { };
    inherit hostName;
  };

  # Configuration specific to muninn
  den.aspects.muninn = {
    includes = [
      den.aspects._1password
      den.aspects.browsers
      den.aspects.certbot
      den.aspects.fonts
      den.aspects.ghostty
      den.aspects.audio
      den.aspects.zed

      # Binary cache for the other machines on the LAN
      den.aspects.attic.server
    ];

    nixos = {
      # Generated by `nixos-generate-config` on muninn. The leading `_` keeps
      # import-tree from loading it as a flake module.
      imports = [ ./_hardware-configuration.nix ];

      # UEFI: the ESP is the vfat /boot in the hardware configuration
      boot.loader.systemd-boot.enable = true;
      boot.loader.efi.canTouchEfiVariables = true;

      # Headless server: SSH is the way in. Keys only (alberth's come from his
      # meta.authorizedKeys). This also creates /etc/ssh/ssh_host_ed25519_key, the
      # key sops-nix decrypts system secrets with. Port 22 is opened in the firewall.
      services.openssh = {
        enable = true;
        settings = {
          PasswordAuthentication = false;
          KbdInteractiveAuthentication = false;
        };
      };

      system.stateVersion = "26.05";

      local.certbot = {
        email = "${certbotOwners}";
        fqdns = [
          "${hostName}.home.matos.cc"
          "${hostName}.ts.matos.cc"
        ];
      };
    };
  };

  # alberth is the primary user on muninn (system.primaryUser on macOS, wheel on NixOS).
  den.aspects.muninn.provides.alberth.includes = [ den.batteries.primary-user ];
}
