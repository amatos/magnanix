# Host:      muninn (den.aspects.muninn)
# Platform:  x86_64-linux (NixOS)
# Purpose:   Headless home server: the Attic binary cache server, the SMTP smart
#            relay to Fastmail for the LAN and tailnet, certbot, Tailscale, and
#            SSH (keys only) as the only way in.
#
# Notes:
# - The relay's ports (25, 465) are opened only on the LAN NIC and tailscale0.
# - Requests certificates for muninn.home.matos.cc and muninn.ts.matos.cc (the
#   relay adds smtp.home / smtp.ts).
# - Also pushes its own builds to the cache (attic.push).
{ den, ... }:
let
  hostName = "muninn";
  certbotOwners = "alberth@matos.cc";
in
{
  # Den sets nixpkgs.hostPlatform from this key; it matches the x86_64-linux in
  # _hardware-configuration.nix.
  den.hosts.x86_64-linux.muninn = {
    users.alberth = { };
    inherit hostName;
  };

  # Configuration specific to muninn
  den.aspects.muninn = {
    includes = [
      den.aspects.bluetooth
      den.aspects.certbot
      den.aspects.fonts
      den.aspects.audio
      den.aspects.tailscale

      # Headless server: SSH (keys only) is the way in. It also creates
      # /etc/ssh/ssh_host_ed25519_key, the key sops-nix decrypts system secrets with.
      den.aspects.openssh

      # Binary cache for the other machines on the LAN
      den.aspects.attic.server
      # Push what muninn builds to it
      den.aspects.attic.push

      # SMTP smart relay to Fastmail for the LAN and the tailnet
      den.aspects.mail.relay
    ];

    nixos = {
      # Generated by `nixos-generate-config` on muninn. The leading `_` keeps
      # import-tree from loading it as a flake module.
      imports = [ ./_hardware-configuration.nix ];

      system.stateVersion = "26.05";

      # The LAN NIC and Tailscale: where the SMTP relay's port 25 is open.
      local.mail.relay.interfaces = [
        "enp0s31f6"
        "tailscale0"
      ];

      local.certbot = {
        email = "${certbotOwners}";
        fqdns = [
          "${hostName}.home.matos.cc"
          "${hostName}.ts.matos.cc"
        ];
      };
    };
  };

  # alberth is the primary user on muninn (system.primaryUser on macOS, wheel on NixOS).
  den.aspects.muninn.provides.alberth.includes = [ den.batteries.primary-user ];
}
