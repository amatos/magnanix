# Apple's iWork apps: Pages, Keynote and Numbers.
#
# Installed from the App Store by `brew bundle` through `mas`, which needs you
# signed in to the App Store.
{
  den.aspects.macos.iwork = {
    darwin.homebrew.masApps = {
      "Pages" = 361309726;
      "Keynote" = 361285480;
      "Numbers" = 361304891;
    };
  };
}
